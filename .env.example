# ---------------------------------------------------------------------------
# Browser (Vite) — these are PUBLIC values. Never put secrets in VITE_ vars.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public site URL used for canonical links, Open Graph and auth redirects
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Server-side only — set with `supabase secrets set KEY=value` (Edge Functions)
# or in your shell for the scripts/ commands. NEVER commit real values.
# ---------------------------------------------------------------------------
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# Edge Functions. The upload script needs them locally:
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=never-commit-this

SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_SALT=generate-a-long-random-string

# Payments — leave PAYMENT_PROVIDER empty until the provider has approved the
# business. While empty, checkout stays disabled and shows the enquiry option.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order confirmation email (optional; https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="CODEVANTASOLUTIONSLTD <orders@your-verified-domain.example>"

# Lets `npm run supabase:sync` (and `npm run dev`) update Supabase automatically.
SUPABASE_ACCESS_TOKEN=
# Optional: after you register with this email, the next sync makes that account admin.
ADMIN_EMAIL=
