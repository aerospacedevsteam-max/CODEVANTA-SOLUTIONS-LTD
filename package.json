{
  "name": "codevantasolutionsltd-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/supabase-sync.mjs --if-configured",
    "supabase:sync": "node scripts/supabase-sync.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "products:previews": "node scripts/generate-previews.mjs",
    "products:build": "node scripts/build-products.mjs",
    "products:upload": "node scripts/upload-products.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "seed:generate": "node scripts/generate-seed.mjs",
    "spreadsheets:build": "node scripts/spreadsheets/build-spreadsheets.mjs && node scripts/spreadsheets/verify-spreadsheets.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "exceljs": "^4.4.0",
    "html-validate": "^11.17.0",
    "hyperformula": "^3.5.0",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
